<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My GitHub Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header / Navigation -->
    <header>
        <nav class="container">
            <h1 class="logo">DevSite</h1>
            <ul class="nav-links">
                <li><a href="#hero">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="container">
        <div class="hero-content">
            <h2>Welcome to My Website</h2>
            <p>Hosted seamlessly on GitHub Pages.</p>
            <button id="cta-btn">Click Me</button>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="container">
        <h3>About This Project</h3>
        <p>This is a lightweight starter template designed for developers looking to quickly deploy a static site to GitHub.</p>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>&copy; 2026 Your Name. Built with GitHub Pages.</p>
        </div>
    </footer>

    <script src="script.js"></script>
</body>
</html>
